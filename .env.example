# Copy to .env and adjust for local overrides. docker-compose.yml already has safe
# dev-only defaults for all of these, so `docker compose up` works without this file —
# use it when you want to change something (a real secret key, a different domain, etc).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Inside docker compose, DB host is "db"; for `uv run` against the compose db from the
# host machine (e.g. `make test`), use "localhost" instead — compose publishes 5432.
DATABASE_URL=postgres://uniware:uniware@localhost:5432/uniware
POSTGRES_DB=uniware
POSTGRES_USER=uniware
POSTGRES_PASSWORD=uniware

APPROVED_EMAIL_DOMAIN=chula.ac.th

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
